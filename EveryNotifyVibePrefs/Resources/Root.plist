<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>EveryNotifyVibe</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>EveryNotifyVibe</string>
			<key>footerText</key>
			<string>With normal iOS 16 notification behaviour, apps such as Snapchat can vibrate for the first notification while notifications arriving straight afterwards may not vibrate again. EveryNotifyVibe fixes that by forcing every incoming notification from enabled apps to vibrate, including repeated and grouped notifications. Made by 551.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enabled</string>
			<key>defaults</key>
			<string>com.local.everynotifyvibe.preferences</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.local.everynotifyvibe.preferences/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Per-App Control</string>
			<key>footerText</key>
			<string>All apps are enabled by default. The Applications page has a search bar, separate third-party and system-app sections with icons, and an Actions menu for bulk enable/disable controls.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>Applications</string>
			<key>detail</key>
			<string>ENVApplicationListController</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Developer</string>
			<key>footerText</key>
			<string>Made by 551. Tap below to visit the developer on GitHub.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>GitHub — @551UK</string>
			<key>action</key>
			<string>openGitHub</string>
		</dict>
	</array>
</dict>
</plist>

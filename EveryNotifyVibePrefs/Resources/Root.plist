<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>EveryNotifyVibe</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>EveryNotifyVibe</string>
            <key>footerText</key>
            <string>On iOS 16, apps such as Snapchat can vibrate for the first notification but deliver notifications arriving straight afterwards without another vibration. EveryNotifyVibe forces every notification from enabled apps to vibrate, including repeated and grouped notifications.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Enabled</string>
            <key>defaults</key><string>com.local.everynotifyvibe.preferences</string>
            <key>key</key><string>Enabled</string>
            <key>default</key><true/>
            <key>PostNotification</key><string>com.local.everynotifyvibe.preferences/ReloadPrefs</string>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>Per-App Control</string>
            <key>footerText</key>
            <string>All apps are enabled by default. Turn an app off and EveryNotifyVibe will not touch its notifications; that app returns to normal stock iOS vibration behaviour.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSLinkCell</string>
            <key>label</key><string>Applications</string>
            <key>detail</key><string>ENVApplicationListController</string>
        </dict>
    </array>
</dict>
</plist>
